        {
          "@type": "Question",
          "name": "How do I know if my house on the Wirral needs a complete rewire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common warning signs in older Wirral properties (especially period homes in Heswall, Caldy, or West Kirby) include original fabric or rubber insulated cables, fuse boxes with rewireable fuse wire, dimming lights, or a lack of earthing on metal switches."
          }
        },
        {
          "@type": "Question",
          "name": "What electrical certificate is legally required for rented properties on the Wirral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Landlords across Wirral Council postcodes must possess a valid Electrical Installation Condition Report (EICR) issued by a registered electrician every 5 years. Failure to comply can result in local authority fines of up to £30,000."
          }
        },
        {
          "@type": "Question",
          "name": "Is an NICEIC Approved Contractor required for commercial premises in Bromborough?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "While the law requires a \"competent person\", using an NICEIC Approved Contractor guarantees that the business meets rigorous annual technical assessments. We service retail units, offices, and industrial facilities in Bromborough and Birkenhead."
          }
        },
        {
          "@type": "Question",
          "name": "What is Part P building regulations compliance for domestic electrical work on the Wirral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Part P requires that electrical installations in dwellings are designed and installed safely. Major additions, bathroom alterations, and fuse box upgrades must be notified to Building Control. We handle all notifications and issue official certificates automatically."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a domestic smart EV charger installation take on the Wirral?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard domestic wallbox installation takes between 3 and 4 hours. Our engineers verify your main fuse board capacity, install dedicated cable routing, configure smart app control, and notify SP Energy Networks."
          }
        },
        {
          "@type": "Question",
          "name": "Which postcodes and towns do you cover across the Wirral peninsula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cover the entire Wirral including CH47, CH48, CH60, CH61, CH62, and CH63 postcodes, serving Heswall, Caldy, West Kirby, Bromborough, Bebington, Neston, Parkgate, and Willaston."
          }
        }
