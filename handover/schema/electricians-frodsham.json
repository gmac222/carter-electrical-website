        {
          "@type": "Question",
          "name": "What emergency lighting regulations apply to commercial premises in Frodsham?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under the Regulatory Reform (Fire Safety) Order 2005, commercial premises on Frodsham High Street and Main Street must maintain emergency escape lighting to BS 5266 standards. This requires monthly function checks and annual 3-hour battery discharge testing."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to replace a consumer unit in a Frodsham property?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A complete consumer unit replacement takes approximately 4 to 6 hours. This includes isolating the supply, installing a modern metal RCBO board with Surge Protection (SPD), and performing 100% circuit safety testing before re-energising."
          }
        },
        {
          "@type": "Question",
          "name": "Are EICR safety checks mandatory for private landlords in Frodsham and Helsby?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Private landlords must obtain an EICR every 5 years or at the start of any new tenancy. We carry out non-invasive testing across WA6 postcodes, identifying potential safety defects and delivering digital reports within 48 hours."
          }
        },
        {
          "@type": "Question",
          "name": "Do you install home EV chargers for rural properties around Frodsham?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We install smart wallboxes for homes in Frodsham, Helsby, Kingsley, and Alvanley. We evaluate your incoming mains supply and coordinate DNO approval with SP Energy Networks for seamless charging."
          }
